{
  "name": "vedadarshi-functions",
  "description": "Cloud Functions for Vedadarshi — Vedika API proxy",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "purge-cache": "tsc && node lib/scripts/purgeVedikaCache.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "puppeteer-core": "^25.11.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "private": true
}
