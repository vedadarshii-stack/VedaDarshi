# Non-secret Cloud Functions config. This file IS uploaded with the function
# source at deploy time, so NOTHING SENSITIVE MAY GO IN HERE — no API keys, no
# credentials. Secrets live in Secret Manager (`firebase functions:secrets:set`)
# and are declared with `defineSecret` in src/config.ts.
#
# Going live against the paid Vedika API is a change to the line below plus a
# real VEDIKA_API_KEY secret, then a redeploy. No code edit.
#   VEDIKA_BASE_URL=https://api.vedika.io
VEDIKA_BASE_URL=https://api.vedika.io/sandbox
