<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runtime permission on Android 13+ (API 33) — without this, FCM
         notifications never appear on API 33+ devices even though older
         devices behave normally. Declaring it in the manifest is necessary
         but NOT sufficient: it must also be requested at runtime (see
         PushNotificationService.requestPermission, called when the user
         first reaches NotificationsScreen), or the OS blocks the prompt
         entirely. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- COARSE location only (21 Aug 2026), for the Panchang location.
         Sunrise, sunset and Rahu Kaal depend on where the user IS, and the
         app previously computed them from the BIRTH city.

         Coarse, never fine: the fix is resolved to the nearest city in the
         bundled offline dataset on-device (assets/data/cities.json), and only
         that city's own published coordinates are ever sent to Vedika — the
         device's actual position never leaves the phone. City-level accuracy
         is all a panchang needs.

         Optional in every sense: denial is a supported path (the app falls
         back to the birth city), and Settings has a manual city picker that
         overrides detection entirely. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application
        android:label="Vedadarshi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- FCM defaults applied to every notification that doesn't specify
             its own icon/color/channel (i.e. every notification we send,
             since the admin composer only sets title/body). MUST reference
             the monochrome ic_notification drawable, not the launcher icon —
             Android renders a non-monochrome icon as a solid grey blob on the
             status bar (API 21+ requirement). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vedadarshi_default" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
