# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit a real key.
#
# Google Places API key (Place of Birth search on the Birth Details screen).
# Needs "Places API (New)" enabled + billing on the Google Cloud project, and
# the key restricted to the Android app (package com.vedadarshi.vedadarshi +
# SHA-1) with its API restriction set to Places API only.
# Leave blank to fall back to the bundled offline city dataset.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Vedika Intelligence API (astrology data: panchang, horoscope, kundli,
# guna milan). THIS IS THE ONE LINE THAT CHANGES TO GO LIVE.
#
#   Sandbox (default) — free, no key, but returns FIXED sample data and
#   ignores the birth details you send it:
#     VEDIKA_BASE_URL=https://api.vedika.io/sandbox
#
#   Live — point at our Cloud Functions proxy, which holds the paid API key
#   server-side. Never point the app straight at https://api.vedika.io in a
#   shipped build: that needs an X-API-Key, and a key bundled in the APK is
#   readable by anyone who unzips it and is billed per call.
#     VEDIKA_BASE_URL=https://<region>-vedadarshi-20989.cloudfunctions.net/vedika
#
# Leave blank to use the sandbox.
VEDIKA_BASE_URL=

# LOCAL DEVELOPER TESTING ONLY — lets you hit production Vedika directly
# before the proxy exists. Never set this in a build you distribute.
VEDIKA_API_KEY=
