rules_version = '2';

// Vedadarshi Firestore security rules.
//
// Principle: a signed-in user can read and write ONLY their own document
// tree under /users/{uid}. Nothing else in the database is reachable from
// the client — server-side work (Vedika API proxying, cached panchang and
// horoscopes, payments) runs through Cloud Functions with the Admin SDK,
// which bypasses these rules entirely.
//
// Birth profiles carry date/time/place of birth, i.e. personal data, so the
// ownership check is deliberately strict: no cross-user reads, no public
// listing, no client-side deletes of the account document.
//
// ADDED 30 Jul 2026: console role management (/adminRoles, /adminUsers).
// That block is purely ADDITIVE — the /users rules further down are unchanged,
// so the Flutter app's access is exactly as before.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- Console admin helpers -------------------------------------------
    //
    // Membership is a document keyed by the Firebase Auth uid, so authorising
    // an admin costs exactly one get(). Revoking access means setting
    // status != 'active' (or deleting the doc) and takes effect immediately —
    // no token refresh needed, which is the main reason this is a Firestore
    // document rather than a custom claim.
    //
    // BOOTSTRAP: only a super admin may write /adminUsers, so the FIRST
    // super-admin document cannot come from the client. It was seeded
    // out-of-band through the Admin API (Firebase MCP) on 30 Jul 2026 —
    // adminUsers/aoQtxM9rFDc75CpJ3vovA4FRe1h1 (ppradeepd@gmail.com).
    // Recover the same way if every super admin is ever locked out.
    function adminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
             && adminDoc().status == 'active';
    }

    function isSuperAdmin() {
      return isAdmin() && adminDoc().roleId == 'super_admin';
    }

    // ---- Invite claiming -------------------------------------------------
    //
    // An admin document is keyed by uid, but a person you want to invite has no
    // uid until they sign in for the first time. So a super admin drops a doc in
    // /adminInvites/{lowercased-email}, and the invitee converts it into their
    // own /adminUsers/{uid} on first sign-in.
    //
    // This is the ONLY path by which a user may create their own admin document,
    // so every clause below matters:
    //   - the uid being written must be the caller's own;
    //   - the email must be VERIFIED (Google sign-in always is) — otherwise
    //     anyone could claim an invite by asserting someone else's address;
    //   - the role comes from the invite, never from the request body, so a
    //     claimer cannot promote themselves;
    //   - status is pinned to 'active' and the stored email is pinned to the
    //     token's email.
    // `create` only applies when the document does not exist, so this can never
    // overwrite or escalate an existing admin.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function invite() {
      return get(/databases/$(database)/documents/adminInvites/$(callerEmail())).data;
    }

    function hasValidInvite(adminUid) {
      return isSignedIn()
             && request.auth.uid == adminUid
             && request.auth.token.email_verified == true
             && exists(/databases/$(database)/documents/adminInvites/$(callerEmail()))
             && request.resource.data.uid == adminUid
             && request.resource.data.email == callerEmail()
             && request.resource.data.status == 'active'
             && request.resource.data.roleId == invite().roleId;
    }

    // Pending invites: /adminInvites/{lowercased-email}
    match /adminInvites/{inviteEmail} {
      // The invitee must be able to read their own invite in order to claim it.
      allow get: if isAdmin()
                 || (isSignedIn()
                     && request.auth.token.email_verified == true
                     && callerEmail() == inviteEmail);
      allow list: if isAdmin();
      allow create, update: if isSuperAdmin();
      // The invitee deletes their own invite as the last step of claiming it.
      // Leaving spent invites around would let a REVOKED admin re-claim access.
      allow delete: if isSuperAdmin()
                    || (isSignedIn()
                        && request.auth.token.email_verified == true
                        && callerEmail() == inviteEmail);
    }

    // Console operators: /adminUsers/{uid}
    // NOT app end-users — those live in /users/{uid} below. Keep the two
    // straight; conflating them would hand console access to every app user.
    match /adminUsers/{adminUid} {
      // Any signed-in user may read THEIR OWN row, so the console can answer
      // "which role am I?" immediately after sign-in (and show a clean
      // "not an admin" screen when the row is absent). Reading anyone else's
      // row requires already being an admin.
      allow get: if isAdmin() || isOwner(adminUid);
      allow list: if isAdmin();
      // Granting access is super-admin only, OR a first-time invitee claiming
      // the invite left for their verified email (see hasValidInvite above).
      allow create: if isSuperAdmin() || hasValidInvite(adminUid);
      // Editing and revoking stay super-admin only — no self-service here.
      allow update, delete: if isSuperAdmin();
    }

    // Role definitions: /adminRoles/{roleId}
    match /adminRoles/{roleId} {
      allow get, list: if isAdmin();
      allow create, update: if isSuperAdmin();
      // System roles (super_admin) must never be deletable, or the project can
      // lock itself out of its own console.
      allow delete: if isSuperAdmin() && resource.data.isSystem != true;
    }

    // ---- App end-users (UNCHANGED from the previously deployed rules) ----

    // Account document: /users/{uid}
    match /users/{userId} {
      allow get: if isOwner(userId);
      // No `list` — a client must never be able to enumerate users.
      allow create, update: if isOwner(userId)
                            && request.resource.data.uid == userId;
      // Account deletion must go through a Cloud Function so the whole
      // subtree (profiles, reports, chat history) is removed atomically.
      allow delete: if false;

      // Birth profiles: /users/{uid}/birthProfiles/{profileId}
      // A subcollection rather than a field on the user doc, because the
      // approved design promises family & friends profiles later.
      match /birthProfiles/{profileId} {
        allow read, write: if isOwner(userId);
      }

      // AI credit ledger: /users/{uid}/aiUsage/{dateKey}
      // ADDED 1 Aug 2026 alongside functions/src/aiCredits.ts. This tracks
      // the reserve → call → commit-or-release transaction that protects
      // AI credits ("deduct only after a real 200 OK from Vedika"). It
      // MUST be read-only for the client: if the owner could write here
      // directly, they could set `used`/`pending` to 0 (or any number)
      // themselves and bypass the daily limit entirely — the whole point
      // of doing the accounting server-side in a transaction. This match
      // block has to come BEFORE the generic `{subcollection}` wildcard
      // below AND that wildcard has to explicitly exclude 'aiUsage',
      // because Firestore rules are a logical OR across every `match`
      // block that matches a given path — a narrower `allow write: if
      // false` here would NOT override a broader wildcard that still
      // said yes.
      match /aiUsage/{dateKey} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Any future per-user subcollection (saved reports, AI chat history)
      // inherits the same ownership rule instead of being open by
      // omission — EXCEPT 'aiUsage', carved out above for the reason
      // explained there.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) && subcollection != 'aiUsage';
      }
    }

    // ---- Server-pre-warmed public cache (Cloud Functions writes only) ----
    //
    // ADDED 1 Aug 2026 alongside functions/src/dailyPrewarm.ts. Panchang
    // and horoscopes are identical for every user who shares a city/sign
    // on a given day, so a scheduled function fetches them ONCE from
    // Vedika at 12:01 AM IST and every signed-in user reads Firestore
    // instead of triggering their own paid Vedika call. That is the
    // entire point of these two collections existing, which is also why
    // they must never be client-writable: a client write here would let
    // anyone plant fabricated "official" horoscope/panchang content that
    // every OTHER user then reads as if Vedika had said it. Only the
    // Admin SDK (Cloud Functions, which bypasses these rules) writes to
    // either collection — no `allow write` appears below on purpose.
    match /dailyHoroscopes/{docId} {
      allow read: if isSignedIn();
    }

    match /dailyPanchang/{docId} {
      allow read: if isSignedIn();
    }

    // ---- Vedika response cache (Cloud Functions only, not even readable) -
    //
    // Keyed by an FNV-1a hash of method+path+query+body (see
    // functions/src/index.ts `cacheKey`), not something any client should
    // ever address directly — the `vedika` proxy function is the only
    // reader/writer, and it uses the Admin SDK, which bypasses these
    // rules entirely. This block is written out explicitly (rather than
    // relying on the implicit default-deny for an unmatched path) so the
    // "nobody but the proxy touches this" intent is visible in the rules
    // themselves, not just inferred from its absence.
    match /vedikaCache/{docId} {
      allow read, write: if false;
    }
  }
}
